{
  "name": "@twigg/agent",
  "version": "0.1.0",
  "description": "A one-shot, non-interactive agent CLI for the Twigg API, with pluggable tools",
  "license": "MIT",
  "type": "module",
  "bin": {
    "twigg-agent": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Twigg-AI-Ltd/twigg-agent.git",
    "directory": "packages/agent"
  },
  "homepage": "https://github.com/Twigg-AI-Ltd/twigg-agent#readme",
  "keywords": [
    "agent",
    "cli",
    "llm",
    "twigg",
    "tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "gen:api": "pnpm dlx --package openapi-typescript@7 --package typescript@5 openapi-typescript https://api.twigg.ai/openapi.json --empty-objects-unknown -o src/api/schema.d.ts",
    "prepack": "node build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "picomatch": "^4.0.7"
  }
}
